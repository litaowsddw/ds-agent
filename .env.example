APP_ENV=development
DATABASE_URL=mysql+aiomysql://agentflow:agentflow@mysql:3306/agentflow?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
AGENTFLOW_PERSISTENCE=1
AGENTFLOW_STATE_FILE=.agentflow/state.pkl
AGENTFLOW_VECTOR_BACKEND=milvus
AGENTFLOW_EMBEDDING_PROVIDER=local-hash
AGENTFLOW_EMBEDDING_MODEL=local-hash-embedding-v1
AGENTFLOW_EMBEDDING_DIMENSION=256
# 语义 Embedding（推荐生产）：OpenAI 兼容接口
# AGENTFLOW_EMBEDDING_PROVIDER=openai-compatible
# AGENTFLOW_EMBEDDING_BASE_URL=https://your-provider/v1
# AGENTFLOW_EMBEDDING_API_KEY=sk-...
# AGENTFLOW_EMBEDDING_MODEL=text-embedding-v4
# AGENTFLOW_EMBEDDING_DIMENSION=1024
# 切换 embedding 模型必须同时换 collection（维度不同）
# MILVUS_COLLECTION=agentflow_knowledge_chunks_te_v4
# For local Ollama embeddings, use:
# AGENTFLOW_EMBEDDING_PROVIDER=ollama
# AGENTFLOW_EMBEDDING_BASE_URL=http://host.docker.internal:11434
# AGENTFLOW_EMBEDDING_MODEL=bge-m3:latest
# AGENTFLOW_EMBEDDING_DIMENSION=1024
# MILVUS_COLLECTION=agentflow_knowledge_chunks_bge_m3
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=agentflow_knowledge_chunks

# Production deployment values are intentionally blank. Generate unique values
# in the ignored .env file; never commit production credentials.
DEPLOY_USER=
DEPLOY_PASSWORD_HASH=
JWT_SECRET=
ENCRYPTION_KEY=
MYSQL_ROOT_PASSWORD=
MYSQL_USER=agentflow
MYSQL_PASSWORD=
MYSQL_DATABASE=agentflow
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
