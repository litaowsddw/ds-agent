APP_ENV=development
DATABASE_URL=postgresql+psycopg://agentflow:agentflow@postgres:5432/agentflow
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
AGENTFLOW_PERSISTENCE=1
AGENTFLOW_STATE_FILE=.agentflow/state.pkl
AGENTFLOW_VECTOR_BACKEND=milvus
AGENTFLOW_EMBEDDING_MODEL=local-hash-embedding-v1
AGENTFLOW_EMBEDDING_DIMENSION=256
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=agentflow_knowledge_chunks
